+// Millennial Global: el cliente 15.25 espera estos numeros en el aviso de subida de skill
+// (1 Magic Level, 2 Sword, 3 Club, 4 Axe, 5 Fist, 6 Distance, 7 Shielding, 8 Fishing).
+// Los numeros de getCipbiaSkill() no coinciden con los de ese aviso y mostraban otra skill.
+uint8_t getSkillupToastId(skills_t skill) {
+	switch (skill) {
+		case SKILL_MAGLEVEL:
+			return 1;
+		case SKILL_SWORD:
+			return 2;
+		case SKILL_CLUB:
+			return 3;
+		case SKILL_AXE:
+			return 4;
+		case SKILL_FIST:
+			return 5;
+		case SKILL_DISTANCE:
+			return 6;
+		case SKILL_SHIELD:
+			return 7;
+		case SKILL_FISHING:
+			return 8;
+		default:
+			return 0;
+	}
+}
